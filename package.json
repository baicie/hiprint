{
  "name": "hiprint-re",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "pnpm --filter @hiprint-re/playground-legacy dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:core": "vitest run tests/core",
    "test:watch": "vitest",
    "check:core": "pnpm --filter @hiprint-re/core typecheck && pnpm test:core",
    "lint": "eslint .",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "check:fixtures": "tsx tools/scripts/check-fixtures.ts",
    "reverse": "tsx tools/reverse-audit/scan.ts",
    "test:layout": "vitest run tests/core/layout",
    "check:layout": "pnpm --filter @hiprint-re/core typecheck && pnpm test:layout",
    "dev:dom": "pnpm --filter @hiprint-re/playground-dom dev",
    "test:dom": "vitest run tests/dom",
    "check:dom": "pnpm --filter @hiprint-re/dom typecheck && pnpm test:dom",
    "dev:react": "pnpm --filter @hiprint-re/playground-react dev",
    "dev:vue": "pnpm --filter @hiprint-re/playground-vue dev",
    "test:react": "vitest run tests/react",
    "test:vue": "vitest run tests/vue",
    "check:react": "pnpm --filter @hiprint-re/react typecheck && pnpm test:react",
    "check:vue": "pnpm --filter @hiprint-re/vue typecheck && pnpm test:vue",
    "check:adapters": "pnpm check:react && pnpm check:vue",
    "test:designer-core": "vitest run tests/designer-core",
    "check:designer-core": "pnpm --filter @hiprint-re/designer-core typecheck && pnpm test:designer-core",
    "dev:designer-react": "pnpm --filter @hiprint-re/playground-designer-react dev",
    "dev:designer-vue": "pnpm --filter @hiprint-re/playground-designer-vue dev",
    "test:designer-react": "vitest run tests/designer-react",
    "check:designer-react": "pnpm --filter @hiprint-re/designer-react typecheck && pnpm test:designer-react",
    "check:designer-vue": "pnpm --filter @hiprint-re/designer-vue typecheck && pnpm test:designer-vue"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.7",
    "@babel/traverse": "^7.29.7",
    "@babel/types": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vue/test-utils": "^2.4.10",
    "eslint": "^10.4.1",
    "fast-glob": "^3.3.3",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  }
}
