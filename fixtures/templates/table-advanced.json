{
  "version": "1.0.0",
  "panels": [
    {
      "index": 0,
      "width": 210,
      "height": 297,
      "elements": [
        {
          "id": "header-text",
          "type": "text",
          "x": 0,
          "y": 0,
          "width": 210,
          "height": 12,
          "options": { "content": "水果配送订单单据" },
          "style": { "fontSize": 16, "fontWeight": 700, "textAlign": "center" }
        },
        {
          "id": "order-info",
          "type": "text",
          "x": 10,
          "y": 15,
          "width": 190,
          "height": 10,
          "options": {
            "content": "订单号：{{orderNo}}    客户：{{customer.name}}    订单日期：{{orderDate}}    业务员：{{salesman}}"
          },
          "style": { "fontSize": 9, "color": "#666" }
        },
        {
          "id": "table_items",
          "type": "table",
          "x": 10,
          "y": 28,
          "width": 190,
          "height": 200,
          "options": {
            "dataField": "items",
            "columns": [
              { "id": "col_index", "field": "index", "title": "序号", "width": 18, "align": "center" },
              { "id": "col_name", "field": "name", "title": "商品名称", "width": 50, "align": "left" },
              { "id": "col_spec", "field": "spec", "title": "规格", "width": 45, "align": "left" },
              { "id": "col_qty", "field": "quantity", "title": "数量", "width": 18, "align": "center" },
              { "id": "col_price", "field": "price", "title": "单价", "width": 25, "align": "right" },
              { "id": "col_amount", "field": "amount", "title": "金额", "width": 25, "align": "right" }
            ],
            "header": {
              "show": true,
              "repeatOnPageBreak": true,
              "height": 8
            },
            "body": {
              "rowHeight": 8
            },
            "pagination": {
              "enabled": true,
              "repeatHeader": true,
              "footerMode": "last-page",
              "rowBreakMode": "avoid",
              "allowPageBreak": true
            }
          },
          "style": { "borderColor": "#333", "borderWidth": 0.5 }
        },
        {
          "id": "footer-summary",
          "type": "text",
          "x": 10,
          "y": 235,
          "width": 190,
          "height": 8,
          "options": {
            "content": "合计：共 {{totalQuantity}} 件商品，订单金额 ¥{{totalAmount}}，优惠 ¥{{discount}}，应收 ¥{{finalAmount}}"
          },
          "style": { "fontSize": 10, "fontWeight": 700, "textAlign": "right" }
        },
        {
          "id": "remark",
          "type": "text",
          "x": 10,
          "y": 245,
          "width": 190,
          "height": 8,
          "options": { "content": "备注：{{remark}}" },
          "style": { "fontSize": 8, "color": "#888" }
        },
        {
          "id": "footer-line",
          "type": "line",
          "x": 10,
          "y": 255,
          "width": 190,
          "height": 0,
          "options": { "direction": "horizontal" },
          "style": { "borderColor": "#333", "borderWidth": 0.5 }
        },
        {
          "id": "footer-text",
          "type": "text",
          "x": 10,
          "y": 258,
          "width": 190,
          "height": 6,
          "options": { "content": "客户签字：___________    日期：___________" },
          "style": { "fontSize": 9 }
        }
      ]
    }
  ]
}
